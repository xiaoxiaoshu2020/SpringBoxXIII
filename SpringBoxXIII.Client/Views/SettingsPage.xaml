<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SpringBoxXIII.Client.Views.SettingsPage">
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Entry 
                Text="{Binding ApiBaseAddress}"
                HorizontalOptions="Fill" />
            <Button 
                Text="更改服务器地址"
                Command="{Binding SetBaseAddressCommand}"
                HorizontalOptions="Fill" />
            <Button 
                Text="返回主页"
                Command="{Binding NavigateToMainPageCommand}"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>